---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Spec Led Dev', description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://specled.dev');
const pageTitle = title === 'Spec Led Dev' ? title : `${title} - Spec Led Dev`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      (() => {
        const getTheme = () => {
          const storedTheme = localStorage.getItem('specled-theme');

          if (storedTheme === 'light' || storedTheme === 'dark') {
            return storedTheme;
          }

          return window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        };

        const applyTheme = (theme) => {
          document.documentElement.classList.toggle('dark', theme === 'dark');
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
        };

        applyTheme(getTheme());

        const bindThemeToggles = () => {
          document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
            if (toggle._specledBound === true) {
              return;
            }

            toggle._specledBound = true;

            toggle.addEventListener('click', () => {
              const nextTheme =
                document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';

              localStorage.setItem('specled-theme', nextTheme);
              applyTheme(nextTheme);
            });
          });
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bindThemeToggles, {
            once: true,
          });
        } else {
          bindThemeToggles();
        }

        document.addEventListener('astro:page-load', bindThemeToggles);
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600;1,700;1,800&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical.toString()} />
    <ClientRouter />
  </head>
  <body>
    <div class="flex antialiased">
      <div class="flex-1 min-w-0 max-w-[1400px] mx-auto w-full">
        <slot />
      </div>
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    overscroll-behavior-y: none;
  }

  ::view-transition-old(*),
  ::view-transition-new(*),
  ::view-transition-group(*) {
    animation-duration: 0s !important;
  }
</style>
